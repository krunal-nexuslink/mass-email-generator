# =============================================================================
# Mass Email Generator — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# At least ONE of these is required.

# Groq API key (used by server.py)
GROQ_API_KEY=

# OpenRouter API key (used by server_openrouter.py)
OPENROUTER_API_KEY=

# OpenRouter model override (optional, defaults to meta-llama/llama-3.3-70b-instruct)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── External GPU Server (optional) ────────────────────────────────────────────
# If you're running a separate GPU server for email generation,
# point to its /generate_email endpoint here.
# EMAIL_GENERATION_GPU_SERVER_PATH=http://localhost:7000/generate_email

# ── Google OAuth (for writing results back to Google Sheets) ──────────────────
# Follow OAUTH_SETUP.md to create OAuth credentials in Google Cloud Console.
# These are only needed if you want to write generated emails back to sheets.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET_KEY=

# ── Server Addresses ──────────────────────────────────────────────────────────
# BACKEND_HOST / BACKEND_PORT control the callback URL that Google OAuth
# redirects to after authentication.  The backend itself listens on whatever
# host:port you pass to uvicorn — these values tell OAuth where the backend
# lives.  Change these when deploying behind a reverse proxy or on a different
# port.
#
# BACKEND_URL overrides both; set it directly if your backend runs behind
# a reverse proxy (e.g. https://api.example.com).

BACKEND_HOST=localhost
BACKEND_PORT=7000
# BACKEND_URL=http://localhost:7000

# FRONTEND_URL is used for CORS headers and the OAuth redirect after login.
# If you run the Vite dev server on a non-default port, update this.
FRONTEND_URL=http://localhost:5173

# ── Vite Dev Proxy ────────────────────────────────────────────────────────────
# Tells the Vite dev server where to forward API requests.
# In production, you'd serve the built frontend from the backend or a CDN.
VITE_API_URL=http://localhost:7000
